# ---------------------------------------------------------------
# Klee & Ruben Live — environment settings
# Copy to .env (local) or set these in your host's dashboard.
# Never commit real values. Organizer details (venue, Instagram,
# phone, contact email) are set in the admin dashboard, not here.
# ---------------------------------------------------------------

# Public address of the site, no trailing slash. Must be https:// in production.
BASE_URL=https://YOURDOMAIN.com
PORT=3000
NODE_ENV=production

# Random secret, 32+ characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Where the SQLite database lives. On your host this must be on a persistent disk/volume.
DATABASE_PATH=/data/event.db

# Set to 1 when the app runs behind a proxy/load balancer (Render, Railway, Fly, Nginx) so
# rate limiting sees real visitor IPs. Set to 0 if the app is exposed directly.
TRUST_PROXY=1

# First launch only: creates the owner login for /admin if none exists yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Stripe (raffle payments) -----------------------------------
# Start with TEST keys (sk_test_...). Switch to live keys only after
# legal approval is recorded in the dashboard.
STRIPE_SECRET_KEY=
# From Stripe → Developers → Webhooks → your endpoint → Signing secret (whsec_...)
# Endpoint URL: https://YOURDOMAIN.com/webhooks/stripe
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
#         checkout.session.async_payment_failed, checkout.session.expired,
#         charge.refunded, charge.dispute.created, charge.dispute.closed
STRIPE_WEBHOOK_SECRET=

# ---- Email (Resend) — confirmations, receipts, reminders --------
RESEND_API_KEY=
# Must be on a domain you verified in Resend.
EMAIL_FROM=Klee & Ruben Live <hello@YOURDOMAIN.com>
EMAIL_REPLY_TO=

# ---- SMS (Twilio) — optional --------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Optional extras ---------------------------------------------
# Cloudflare Turnstile bot protection on the RSVP form
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Privacy-friendly analytics (plausible.io) in addition to the built-in dashboard funnel
PLAUSIBLE_DOMAIN=
# Lets an external scheduler call POST /api/cron/run (the app also runs its own worker every minute)
CRON_SECRET=
